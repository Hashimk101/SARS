# ==========================================
# NASA Space Apps - Git Ignore Rules
# ==========================================

# Local hackathon strategy & secret playbooks (NEVER push to GitHub)
HACKATHON_WINNING_SECRETS.md
*.local.md
local/
.local/

# Authentication & Credentials (NEVER push credentials)
.netrc
.env
.env.*
!.env.example
secrets.json

# Heavy SAR Data Files (NISAR HDF5, GeoTIFF, COGs, NetCDF)
data/
raw_data/
processed_data/
*.h5
*.he5
*.nc
*.tif
*.tiff
*.cog
*.tar.gz
*.zip

# Python Environment & Caches
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
.pytest_cache/
.coverage
htmlcov/
.ipynb_checkpoints/

# Node.js & Web Frontend
node_modules/
.next/
dist/
build/
.cache/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS & IDE metadata
.DS_Store
Thumbs.db
.vscode/
.idea/
